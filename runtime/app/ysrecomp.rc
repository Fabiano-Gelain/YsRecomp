// YsRecomp.exe resources: icon (tools/package/make_icon.py) and version information.
// SDL also uses the .exe's first icon for the window and the taskbar.
#include <winver.h>

1 ICON "ysrecomp.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "YsRecomp - Ys Book I & II for PC"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "YsRecomp"
            VALUE "OriginalFilename", "YsRecomp.exe"
            VALUE "ProductName", "YsRecomp"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
